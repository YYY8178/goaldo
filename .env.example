# 本地 Node 开发服务可选配置。不配置模型密钥时，系统会使用内置模板与本地教练。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
PORT=8787

# Cloudflare 部署时由 vite.config.ts 读取。不要在这里放真实密钥。
CF_WORKER_NAME=goaldo-open
CF_D1_DATABASE_NAME=goaldo-db
CF_D1_DATABASE_ID=
CF_CUSTOM_DOMAIN=
CF_ADMIN_EMAIL=admin@example.com
CF_ADMIN_HOSTNAME=admin.example.com
CF_TEAM_DOMAIN=
CF_POLICY_AUD=
CF_ADMIN_POLICY_AUD=

# Public build-time admin routing. Use /admin for a single-domain deployment,
# or set both values when you host the admin console on a separate domain.
VITE_ADMIN_URL=/admin
VITE_ADMIN_HOSTNAME=
